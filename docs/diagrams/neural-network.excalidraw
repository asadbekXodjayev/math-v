    {
      "id": "cap_lbl",
      "type": "text",
      "x": -109.10999999999999,
      "y": 1119.125,
      "width": 298.21999999999997,
      "height": 113.75,
      "angle": 0,
      "strokeColor": "#5f3dc4",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1649940839,
      "version": 1,
      "versionNonce": 1666447133,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "fontSize": 13,
      "fontFamily": 2,
      "text": "CAUSAL = each position predicts the\nNEXT token, looking ONLY to the LEFT.\n\nThe causal mask hides future tokens,\nso the model trains on every position\nat once — yet never \"cheats\" by\npeeking ahead.",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "cap",
      "originalText": "CAUSAL = each position predicts the\nNEXT token, looking ONLY to the LEFT.\n\nThe causal mask hides future tokens,\nso the model trains on every position\nat once — yet never \"cheats\" by\npeeking ahead.",
      "lineHeight": 1.25
    },
